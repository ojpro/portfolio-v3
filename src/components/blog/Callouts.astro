---
import { cn } from "@/utils/utils";

interface Props {
    type?: 'info' | 'warning' | 'error' | 'success';
    title?: string;
}

const calloutStyles = {
    info: {
        container: 'bg-gradient-to-r from-blue-50 to-blue-50/50 dark:from-blue-950/30 dark:to-blue-900/20 border-l-4 border-blue-500',
        icon: 'text-blue-600 dark:text-blue-400',
        title: 'text-blue-900 dark:text-blue-100 font-semibold',
        content: 'text-blue-800/90 dark:text-blue-200/90',
        highlight: 'bg-blue-100/50 dark:bg-blue-800/20 absolute inset-y-0 left-0 w-1 transition-transform group-hover:scale-y-95',
    },
    warning: {
        container: 'bg-gradient-to-r from-amber-50 to-amber-50/50 dark:from-amber-950/30 dark:to-amber-900/20 border-l-4 border-amber-500',
        icon: 'text-amber-600 dark:text-amber-400',
        title: 'text-amber-900 dark:text-amber-100 font-semibold',
        content: 'text-amber-800/90 dark:text-amber-200/90',
        highlight: 'bg-amber-100/50 dark:bg-amber-800/20 absolute inset-y-0 left-0 w-1 transition-transform group-hover:scale-y-95',
    },
    error: {
        container: 'bg-gradient-to-r from-red-50 to-red-50/50 dark:from-red-950/30 dark:to-red-900/20 border-l-4 border-red-500',
        icon: 'text-red-600 dark:text-red-400',
        title: 'text-red-900 dark:text-red-100 font-semibold',
        content: 'text-red-800/90 dark:text-red-200/90',
        highlight: 'bg-red-100/50 dark:bg-red-800/20 absolute inset-y-0 left-0 w-1 transition-transform group-hover:scale-y-95',
    },
    success: {
        container: 'bg-gradient-to-r from-emerald-50 to-emerald-50/50 dark:from-emerald-950/30 dark:to-emerald-900/20 border-l-4 border-emerald-500',
        icon: 'text-emerald-600 dark:text-emerald-400',
        title: 'text-emerald-900 dark:text-emerald-100 font-semibold',
        content: 'text-emerald-800/90 dark:text-emerald-200/90',
        highlight: 'bg-emerald-100/50 dark:bg-emerald-800/20 absolute inset-y-0 left-0 w-1 transition-transform group-hover:scale-y-95',
    },
};

const { type = 'info', title } = Astro.props;
const styles = calloutStyles[type];
---

<div class={cn('group relative my-6 rounded border-0 p-2 transition-all duration-200', styles.container)}>
    <div class={styles.highlight} />
    <div class="flex items-start space-x-3">
        {type === 'info' && (
            <svg class={cn('h-5 w-5 mt-0.5 transition-transform duration-200 ease-out group-hover:scale-110', styles.icon)}
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
        )}
        {type === 'warning' && (
            <svg class={cn('h-5 w-5 mt-0.5 transition-transform duration-200 ease-out group-hover:scale-110', styles.icon)}
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
        )}
        {type === 'error' && (
            <svg class={cn('h-5 w-5 mt-0.5 transition-transform duration-200 ease-out group-hover:scale-110', styles.icon)}
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="15" y1="9" x2="9" y2="15" />
                <line x1="9" y1="9" x2="15" y2="15" />
            </svg>
        )}
        {type === 'success' && (
            <svg class={cn('h-5 w-5 mt-0.5 transition-transform duration-200 ease-out group-hover:scale-110', styles.icon)}
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="8 12 11 15 16 9" />
            </svg>
        )}
        <div class="flex-1 space-y-1">
            {title && (
                <h5 class={cn('leading-6', styles.title)}>{title}</h5>
            )}
            <div class={cn('text-sm leading-relaxed', styles.content)}>
                <slot />
            </div>
        </div>
    </div>
</div>
