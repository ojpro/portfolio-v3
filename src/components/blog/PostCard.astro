---
interface Props {
    title: string;
    slug: string;
    description?: string;
    tags?: string[];
    createdAt?: string;
    thumbnail?: string;
}

const { title, slug, description, tags, createdAt, thumbnail } = Astro.props;
const url = `/blog/${slug}`;
const formattedDate = createdAt
    ? new Date(createdAt).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
      })
    : undefined;
---

<article
    class="group relative hover:bg-gray-100/50 dark:hover:bg-gray-800/50 transition-colors border rounded-sm"
>
    <a href={url} class="block">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 p-3 items-center">
            <div
                class="md:col-span-5 relative aspect-video overflow-hidden rounded-lg border border-gray-500 dark:border-gray-800"
            >
                {
                    thumbnail && (
                        <img
                            src={thumbnail}
                            alt={title}
                            class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                    )
                }
            </div>

            <div class="md:col-span-7 space-y-3">
                {
                    tags && tags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                            {tags.map((tag) => (
                                <span class="px-2.5 py-0.5 bg-gray-100 dark:bg-gray-800 rounded-md text-gray-700 dark:text-gray-300 text-sm">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )
                }

                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
                    {title}
                </h2>

                {
                    description && (
                        <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">
                            {description}
                        </p>
                    )
                }

                <div class="flex items-center justify-between pt-2">
                    <div
                        class="flex items-center gap-1.5 text-gray-500 dark:text-gray-400 text-sm"
                    >
                        <svg
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="4" width="18" height="18" rx="2"
                            ></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        {
                            formattedDate && (
                                <time datetime={createdAt}>
                                    {formattedDate}
                                </time>
                            )
                        }
                    </div>

                    <span
                        class="flex items-center gap-1 text-blue-600 dark:text-blue-400 text-sm font-medium group-hover:gap-2 transition-all"
                    >
                        Read More
                        <svg
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </span>
                </div>
            </div>
        </div>
    </a>
</article>
