---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PostCard from "../../components/blog/PostCard.astro";
import Navbar from "../../components/home/Navbar.astro";
import "@/styles/blog.css";

const posts = (await getCollection("blog"))
    .filter((post) => (import.meta.env.DEV ? true : post.data.isPublished))
    .sort(
        (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
    );
---

<Base
    title="Blog"
    description="All blog posts — tutorials, notes, and things I'm learning along the way."
>
    <Navbar />
    <main class="mx-auto max-w-4xl pt-36 px-4">
        <h1
            class="mb-12 text-center text-4xl font-bold text-gray-900 dark:text-white"
        >
            Recent Posts
        </h1>
        <div class="space-y-12">
            {
                posts.map((post) => (
                    <PostCard
                        slug={post.id}
                        title={post.data.title}
                        description={post.data.description}
                        tags={post.data.tags}
                        createdAt={post.data.publishedAt.toISOString()}
                        thumbnail={post.data.thumbnail?.src}
                    />
                ))
            }
        </div>
    </main>
</Base>
